+/* Local Sony experiment: catch-all for the CXD900xx peripheral window
+ * (0xF0000000..0xFFFFFFFF) during WBI warm-resume experiments. The resumed snapshot
+ * kernel restores drivers that poll real-hardware registers absent on virt; this
+ * region answers reads with all-ones (status "done/ready" bits set) and absorbs
+ * writes. Priority -1000 keeps it below every real device and the SPAcc stub.
+ * NOT a hardware model; a test-environment shim only. */
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+
+#define TYPE_SONY_CXD_BUS_STUB "sony-cxd-bus-stub"
+OBJECT_DECLARE_SIMPLE_TYPE(SonyCxdBusStub, SONY_CXD_BUS_STUB)
+
+struct SonyCxdBusStub {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+};
+
+static uint64_t cxd_bus_read(void *opaque, hwaddr offset, unsigned size)
+{
+    return 0xFFFFFFFF;
+}
+
+static void cxd_bus_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+}
+
+static const MemoryRegionOps cxd_bus_ops = {
+    .read = cxd_bus_read,
+    .write = cxd_bus_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void cxd_bus_realize(DeviceState *dev, Error **errp)
+{
+    SonyCxdBusStub *s = SONY_CXD_BUS_STUB(dev);
+    memory_region_init_io(&s->mmio, OBJECT(dev), &cxd_bus_ops, s,
+                          TYPE_SONY_CXD_BUS_STUB, 0x10000000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mmio);
+}
+
+static void cxd_bus_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = cxd_bus_realize;
+}
+
+static const TypeInfo cxd_bus_info = {
+    .name = TYPE_SONY_CXD_BUS_STUB,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(SonyCxdBusStub),
+    .class_init = cxd_bus_class_init,
+};
+
+static void cxd_bus_register_types(void)
+{
+    type_register_static(&cxd_bus_info);
+}
+type_init(cxd_bus_register_types)
