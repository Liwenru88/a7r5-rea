+++ b/hw/misc/sony_spacc_stub.c
@@ -0,0 +1,75 @@
+/* Local Sony experiment: minimal register model for the CXD900xx SPAcc crypto engine
+ * (phys 0xF7FC0000, 256 KiB). The stock WBI resume path re-keys the eMMC crypto engine
+ * via cryptEmmc_pio_write, which polls status offsets +0x1c (needs bit 20) and +0x4
+ * (bit 18 for the read path). Real hardware semantics are NOT emulated; this only lets
+ * the driver's polling succeed so the resume path proceeds. All offsets are RAM-backed
+ * so the driver's own data writes read back consistently. */
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+
+#define TYPE_SONY_SPACC_STUB "sony-spacc-stub"
+OBJECT_DECLARE_SIMPLE_TYPE(SonySpaccStub, SONY_SPACC_STUB)
+
+struct SonySpaccStub {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    uint32_t *ram;
+};
+
+static uint64_t spacc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    SonySpaccStub *s = opaque;
+    uint32_t value = 0;
+    if (offset + 4 <= 0x40000)
+        memcpy(&value, (uint8_t *)s->ram + offset, 4);
+    if (offset == 0x1c)
+        value |= (1u << 20);   /* cryptEmmc_pio_write: tbz w0,#0x14 is the failure path */
+    if (offset == 0x4)
+        value |= (1u << 20) | (1u << 18);   /* pio_write tests bit 20, pio_read bit 18 */
+    if (g_getenv("QEMU_SONY_SPACC_DEBUG"))
+        fprintf(stderr, "SPACC_STUB read off=%#lx -> %#x\n", (unsigned long)offset, value);
+    return value;
+}
+
+static void spacc_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    SonySpaccStub *s = opaque;
+    if (offset + 4 <= 0x40000) {
+        uint32_t v = value;
+        memcpy((uint8_t *)s->ram + offset, &v, 4);
+    }
+}
+
+static const MemoryRegionOps spacc_ops = {
+    .read = spacc_read,
+    .write = spacc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void spacc_realize(DeviceState *dev, Error **errp)
+{
+    SonySpaccStub *s = SONY_SPACC_STUB(dev);
+    s->ram = g_malloc0(0x40000);
+    memory_region_init_io(&s->mmio, OBJECT(s), &spacc_ops, s,
+                          TYPE_SONY_SPACC_STUB, 0x40000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mmio);
+}
+
+static void spacc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = spacc_realize;
+}
+
+static const TypeInfo spacc_info = {
+    .name = TYPE_SONY_SPACC_STUB,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(SonySpaccStub),
+    .class_init = spacc_class_init,
+};
+
+static void spacc_register_types(void)
+{
+    type_register_static(&spacc_info);
+}
+type_init(spacc_register_types)
