+/*
+ * Native QEMU window keys for the isolated Sony menu experiment.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * This is a host-side bridge, not an emulation of Sony input hardware.
+ * One byte requests one tap; the receiving launcher uses the verified firmware
+ * injection path. Unknown keys and repeats while held are ignored.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "chardev/char-fe.h"
+#include "qom/object.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "ui/sony-ui-input.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(SonyUIInput, SONY_UI_INPUT)
+
+struct SonyUIInput {
+    DeviceState parent_obj;
+    CharFrontend chr;
+    QemuInputHandlerState *handler;
+    char *display;
+    bool held[KEY_MAX + 1];
+};
+
+static unsigned char sony_key(unsigned int key)
+{
+    size_t i;
+
+    switch (key) {
+    case KEY_ESC:     return 'M';
+    case KEY_KPENTER: return 'E';
+    case KEY_F12:     return 'S';
+    default:         break;
+    }
+    for (i = 0; i < G_N_ELEMENTS(sony_ui_actions); i++) {
+        if (key && sony_ui_actions[i].key == key) {
+            return sony_ui_actions[i].command;
+        }
+    }
+    return 0;
+}
+
+static void sony_input_event(DeviceState *dev, QemuConsole *src,
+                             QemuInputEvent *event)
+{
+    SonyUIInput *s = SONY_UI_INPUT(dev);
+    unsigned int key;
+    unsigned char action;
+
+    if (event->type != INPUT_EVENT_KIND_KEY) {
+        return;
+    }
+    key = event->key.key; /* QEMU 11 input API uses Linux key codes. */
+    if (key > KEY_MAX || !(action = sony_key(key))) {
+        return;
+    }
+    if (!event->key.down) {
+        s->held[key] = false;
+        return;
+    }
+    if (s->held[key]) {
+        return;
+    }
+    s->held[key] = true;
+    /* A one-byte record cannot leave a partial command in the stream. */
+    if (qemu_chr_fe_write(&s->chr, &action, 1) != 1) {
+        warn_report("Sony UI key dropped: launcher input channel unavailable");
+    }
+}
+
+static const QemuInputHandler sony_input_handler = {
+    .name = "Sony menu experiment keyboard bridge",
+    .mask = INPUT_EVENT_MASK_KEY,
+    .event = sony_input_event,
+};
+
+static void sony_input_realize(DeviceState *dev, Error **errp)
+{
+    SonyUIInput *s = SONY_UI_INPUT(dev);
+    Error *err = NULL;
+
+    if (!qemu_chr_fe_backend_connected(&s->chr) || !s->display) {
+        error_setg(errp, "sony-ui-input requires chardev and display properties");
+        return;
+    }
+    s->handler = qemu_input_handler_register(dev, &sony_input_handler);
+    qemu_input_handler_bind(s->handler, s->display, 0, &err);
+    if (err) {
+        qemu_input_handler_unregister(s->handler);
+        s->handler = NULL;
+        error_propagate(errp, err);
+        return;
+    }
+    qemu_input_handler_activate(s->handler);
+}
+
+static void sony_input_unrealize(DeviceState *dev)
+{
+    SonyUIInput *s = SONY_UI_INPUT(dev);
+    if (s->handler) {
+        qemu_input_handler_unregister(s->handler);
+        s->handler = NULL;
+    }
+}
+
+static const Property sony_input_properties[] = {
+    DEFINE_PROP_CHR("chardev", SonyUIInput, chr),
+    DEFINE_PROP_STRING("display", SonyUIInput, display),
+};
+
+static bool sony_input_connected(Object *obj, Error **errp)
+{
+    SonyUIInput *s = SONY_UI_INPUT(obj);
+
+    return s->handler && qemu_chr_fe_backend_open(&s->chr);
+}
+
+static void sony_input_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = sony_input_realize;
+    dc->unrealize = sony_input_unrealize;
+    dc->desc = "Sony experimental UI keyboard bridge (host-side)";
+    dc->hotpluggable = false;
+    device_class_set_props(dc, sony_input_properties);
+    object_class_property_add_bool(klass, "input-connected",
+                                   sony_input_connected, NULL);
+}
+
+static const TypeInfo sony_input_type = {
+    .name = TYPE_SONY_UI_INPUT,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(SonyUIInput),
+    .class_init = sony_input_class_init,
+};
+
+static void sony_input_register(void)
+{
+    type_register_static(&sony_input_type);
+}
+type_init(sony_input_register)
