+static Object *gd_sony_bridge(QemuConsole *con)
+{
+    Object *obj = object_resolve_path_type("", TYPE_SONY_UI_INPUT, NULL);
+    g_autofree char *display = NULL;
+
+    if (!obj) {
+        return NULL;
+    }
+    display = object_property_get_str(obj, "display", &error_abort);
+    return display && qemu_console_lookup_by_device_name(display, 0, NULL) == con
+        ? obj : NULL;
+}
+
+static void gd_sony_clicked(GtkButton *button, gpointer opaque)
+{
+    VirtualConsole *vc = opaque;
+    unsigned int action = GPOINTER_TO_UINT(
+        g_object_get_data(G_OBJECT(button), "sony-action"));
+    unsigned int key = sony_ui_actions[action].key;
+    Object *bridge = gd_sony_bridge(vc->gfx.dcl.con);
+
+    gtk_widget_grab_focus(vc->focus);
+    if (!key || !sony_ui_actions[action].command) {
+        return;
+    }
+    if (!runstate_is_running()) {
+        gtk_label_set_text(GTK_LABEL(vc->gfx.sony_status),
+                           "QEMU 已暂停，请先恢复运行");
+        return;
+    }
+    if (!bridge || !object_property_get_bool(bridge, "input-connected", NULL)) {
+        gtk_label_set_text(GTK_LABEL(vc->gfx.sony_status),
+                           "输入通道未连接，未发送操作");
+        return;
+    }
+    /* Do not release a key the user is physically holding. */
+    if (!qkbd_state_key_get(vc->gfx.kbd, key)) {
+        qkbd_state_key_event(vc->gfx.kbd, key, true);
+        qkbd_state_key_event(vc->gfx.kbd, key, false);
+    }
+    gtk_label_set_text(GTK_LABEL(vc->gfx.sony_status),
+                       "操作结果以相机画面为准");
+}
+
+static gboolean gd_sony_key_event(GtkWidget *widget, GdkEventKey *key,
+                                  gpointer opaque)
+{
+    /* Preserve native Tab navigation and Space/Enter button activation. */
+    switch (key->keyval) {
+    case GDK_KEY_Tab:
+    case GDK_KEY_ISO_Left_Tab:
+    case GDK_KEY_space:
+    case GDK_KEY_Return:
+    case GDK_KEY_KP_Enter:
+        return FALSE;
+    default:
+        return gd_key_event(widget, key, opaque);
+    }
+}
+
+static void gd_sony_button(VirtualConsole *vc, GtkWidget *grid,
+                           SonyUIAction action, int col, int row, int width)
+{
+    GtkWidget *button = gtk_button_new_with_label(sony_ui_actions[action].label);
+    bool verified = sony_ui_actions[action].key &&
+                    sony_ui_actions[action].command;
+    g_autofree char *tip = g_strdup_printf("%s · %s",
+        sony_ui_actions[action].label,
+        verified ? "已验证输入；一次点击请求一次操作" : "尚未通过运行验收，当前不可执行");
+
+    gtk_widget_set_tooltip_text(button, tip);
+    gtk_widget_set_sensitive(button, verified);
+    gtk_widget_set_hexpand(button, TRUE);
+    gtk_widget_set_size_request(button, -1, 32);
+    gtk_widget_set_focus_on_click(button, FALSE);
+    g_object_set_data(G_OBJECT(button), "sony-action", GUINT_TO_POINTER(action));
+    g_signal_connect(button, "clicked", G_CALLBACK(gd_sony_clicked), vc);
+    g_signal_connect(button, "key-press-event", G_CALLBACK(gd_sony_key_event), vc);
+    g_signal_connect(button, "key-release-event", G_CALLBACK(gd_sony_key_event), vc);
+    g_signal_connect(button, "focus-in-event", G_CALLBACK(gd_focus_in_event), vc);
+    g_signal_connect(button, "focus-out-event", G_CALLBACK(gd_focus_out_event), vc);
+    gtk_grid_attach(GTK_GRID(grid), button, col, row, width, 1);
+}
+
+static GtkWidget *gd_sony_group(GtkWidget *box, const char *title)
+{
+    GtkWidget *label = gtk_label_new(title);
+    GtkWidget *grid = gtk_grid_new();
+
+    gtk_label_set_xalign(GTK_LABEL(label), 0);
+    gtk_box_pack_start(GTK_BOX(box), label, FALSE, FALSE, 0);
+    gtk_grid_set_column_spacing(GTK_GRID(grid), 4);
+    gtk_grid_set_row_spacing(GTK_GRID(grid), 4);
+    gtk_grid_set_column_homogeneous(GTK_GRID(grid), TRUE);
+    gtk_box_pack_start(GTK_BOX(box), grid, FALSE, FALSE, 0);
+    return grid;
+}
